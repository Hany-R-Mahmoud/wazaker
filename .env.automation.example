AUTOMATION_RUNNER_PORT=3210
AUTOMATION_RUNNER_BASE_URL=http://127.0.0.1:3210
# Required for all runner-backed workflows.
AUTOMATION_RUNNER_TOKEN=replace-with-runner-token
# Required for unattended GitHub automation. Grant repo read/write scopes as needed for PR operations.
AUTOMATION_GITHUB_TOKEN=replace-with-automation-github-token
# Required for GitHub webhook verification.
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
# Required when webhook-triggered GitHub workflows are enabled.
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
# GitHub target example:
# http://127.0.0.1:5678/webhook/GhWebhookRouter01/githubwebhook/github-events

# Optional Plane integration. Required for Plane polling and backlog maintenance workflows.
PLANE_API_BASE_URL=https://api.plane.so
PLANE_WORKSPACE_SLUG=replace-with-plane-workspace
PLANE_PROJECT_ID=replace-with-plane-project-id
PLANE_API_KEY=replace-with-plane-api-key
