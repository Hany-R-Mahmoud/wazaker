{
  "name": "wazaker",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint App.tsx src babel.config.js jest.config.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js --runInBand",
    "test:watch": "jest --config jest.config.js --watch",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "validate:automation": "node ./scripts/validate-automation-assets.mjs",
    "test:automation": "node --test tests/automation/*.test.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "7.1.34",
    "@react-navigation/native-stack": "7.14.6",
    "expo": "55.0.6",
    "expo-av": "16.0.8",
    "expo-status-bar": "55.0.4",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "2.30.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^55.0.12",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^55.0.0",
    "jest-expo": "~55.0.11",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  }
}
